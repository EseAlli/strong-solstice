---
import BlogPost from "../../components/BlogPost.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const allPosts = getPosts();
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.frontmatter.tags))];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { posts: allPosts.filter((post) => post.frontmatter.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout pageTitle={`#${tag}`}>
  <p class="muted">Posts tagged with {tag}</p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <BlogPost url={post.url} title={post.frontmatter.title} pubDate={post.frontmatter.pubDate} />
      ))
    }
  </ul>
</BaseLayout>
