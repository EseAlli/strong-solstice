---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";

const tags = [...new Set(getPosts().flatMap((post) => post.frontmatter.tags))];
---

<BaseLayout pageTitle="Tags">
  <ul class="tags">
    {
      tags.map((tag) => (
        <li>
          <a href={`/tags/${tag}`}>{tag}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
