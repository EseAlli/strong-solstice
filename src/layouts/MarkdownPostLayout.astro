---
import BaseLayout from "./BaseLayout.astro";
import { isoDate, longDate } from "../lib/posts";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description} showTitle={false}>
  <article>
    <h2 class="title">{frontmatter.title}</h2>
    <p class="meta">
      <time datetime={isoDate(frontmatter.pubDate)}>{longDate(frontmatter.pubDate)}</time>
      · {frontmatter.author}
    </p>

    <ul class="tags">
      {
        frontmatter.tags.map((tag: string) => (
          <li>
            <a href={`/tags/${tag}`}>{tag}</a>
          </li>
        ))
      }
    </ul>

    <p class="lead">{frontmatter.description}</p>
    <img src={frontmatter.image.url} alt={frontmatter.image.alt} />

    <div class="content">
      <slot />
    </div>

    <p class="back"><a href="/blog/">← All writing</a></p>
  </article>
</BaseLayout>

<style>
  .title {
    margin: 0 0 0.5rem;
    font-size: 2.5rem;
  }

  .meta {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .meta time {
    color: var(--date);
    font-weight: 700;
  }

  .lead {
    margin: 1rem 0 1.5rem;
  }

  img {
    display: block;
    margin-bottom: 2rem;
  }

  .content {
    font-size: 1.1rem;
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
